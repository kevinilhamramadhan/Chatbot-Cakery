# ─────────────────────────────────────────────────────────────────────────────
# Toti Cakery Chatbot — variabel lingkungan untuk menjalankan chatbot-service
# di laptop (uvicorn / scripts). Di server, nilainya datang dari compose di repo
# Deploy-Toti-Cakery, bukan dari berkas ini.
#
#   cp .env.example chatbot-service/.env
# ─────────────────────────────────────────────────────────────────────────────

# ── Service ───────────────────────────────────────────────────────────────────
ENVIRONMENT=development
LOG_LEVEL=INFO
# Catat isi pesan pelanggan, bukan cuma metadata. Biarkan false di produksi.
LOG_MESSAGE_BODIES=false

# ── Rahasia (WAJIB — service menolak start tanpa ini) ────────────────────────
# Buat masing-masing dengan:  openssl rand -hex 24
# Token di path webhook wwebjs-api (gateway tidak bisa mengirim header).
WEBHOOK_TOKEN=
# X-Internal-Key untuk /webhook/internal/* (dipanggil backend).
INTERNAL_API_KEY=
# Melindungi sesi WhatsApp yang sudah login.
WWEBJS_API_KEY=

# ── Backend ───────────────────────────────────────────────────────────────────
# Base URL backend termasuk /api (backend jalan dengan root_path="/api").
BACKEND_BASE_URL=http://localhost:8001/api
BACKEND_REQUEST_TIMEOUT_SECONDS=30
# Dikirim sebagai X-Service-Key; harus sama persis dengan SERVICE_API_KEY backend.
BACKEND_SERVICE_API_KEY=

# ── Ollama (LLM + embedding) ──────────────────────────────────────────────────
OLLAMA_BASE_URL=http://localhost:11434
LLM_MODEL=toti-qwen-1.7b-v9
EMBEDDING_MODEL=qwen3-embedding:0.6b
LLM_TEMPERATURE=0.3
LLM_TOP_P=0.8
LLM_NUM_CTX=8192
LLM_NUM_PREDICT=192
OLLAMA_KEEP_ALIVE=-1
WARMUP_ON_STARTUP=true

# ── RAG / ChromaDB ────────────────────────────────────────────────────────────
CHROMA_PERSIST_DIR=./chroma_db
CHROMA_COLLECTION=toti_faq
KNOWLEDGE_BASE_DIR=./knowledge_base/faq
RAG_CHUNK_SIZE=512
RAG_CHUNK_OVERLAP=77
RAG_TOP_K=3
# Di bawah kemiripan ini (0..1) pertanyaan dianggap di luar cakupan.
RAG_SIMILARITY_THRESHOLD=0.40
# Berapa detik sekali FAQ dari backend diperiksa ulang.
FAQ_REFRESH_SECONDS=900
INGEST_WAIT_TIMEOUT_SECONDS=1800

# ── WhatsApp gateway (wwebjs-api) ─────────────────────────────────────────────
WWEBJS_BASE_URL=http://localhost:3000
WWEBJS_SESSION_ID=toti

# ── Database lokal chatbot (SQLite) ──────────────────────────────────────────
DATABASE_URL=sqlite+aiosqlite:///./toti_chatbot.db
# Transkrip lebih tua dari ini dihapus. 0 = mati.
DATA_RETENTION_DAYS=90

# ── Pembayaran (charge-nya di backend -> Midtrans) ────────────────────────────
PAYMENT_CHECK_INTERVAL_SECONDS=30
PAYMENT_TIMEOUT_MINUTES=30
ALLOW_DOWN_PAYMENT=true
DOWN_PAYMENT_PERCENTAGE=0.50

# ── Verifikasi nomor WhatsApp (pendaftaran Buyer Site) ───────────────────────
WA_VERIFICATION_ENABLED=false
WA_VERIFICATION_KEYWORD=VERIFIKASI
WA_VERIFICATION_MAX_PER_HOUR=10

# ── Takeover admin & data toko ────────────────────────────────────────────────
# Nomor admin penerima takeover diambil dari backend (GET /admin/takeover-handlers).
TAKEOVER_EXPIRY_DAYS=1
STORE_NAME=Toti Cakery
STORE_ADDRESS=
# Kosong = balasan keluhan tidak menyebut email.
STORE_SUPPORT_EMAIL=
# Nomor yang boleh meminta laporan keuangan, dipisah koma (format 628…).
OWNER_WA_NUMBERS=
