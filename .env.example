# ─────────────────────────────────────────────────────────────────────────────
# Toti Cakery Chatbot — environment variables
# Copy to `.env` and adjust. Everything tunable lives here (PROMPT rules #2/#4).
# ─────────────────────────────────────────────────────────────────────────────

# ── Service ───────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
# Log customer message text as well as metadata. Keep false in production —
# container logs are read by more tools/people than the DB is.
LOG_MESSAGE_BODIES=false

# ── Secrets (REQUIRED — the service refuses to start without them) ────────────
# Generate each one with:  openssl rand -hex 24
#
# WEBHOOK_TOKEN authenticates wwebjs-api's callbacks. The gateway can't send an
# auth header, so the secret rides in the URL path; docker-compose builds
# BASE_WEBHOOK_URL=.../webhook/whatsapp/${WEBHOOK_TOKEN} from this value.
# Without it, anyone able to reach port 8000 can forge a WhatsApp message from
# ANY customer's number and read/cancel that customer's orders.
WEBHOOK_TOKEN=
# Sent as X-Internal-Key on /webhook/internal/* (ends a human takeover, pushes
# "pesanan siap" messages to real customers from the store's number).
INTERNAL_API_KEY=

# ── Backend (teammate's FastAPI) ──────────────────────────────────────────────
BACKEND_BASE_URL=https://backend-cakery.vercel.app
BACKEND_REQUEST_TIMEOUT_SECONDS=30
# Sent as X-Service-Key on backend calls. Must equal the backend's SERVICE_API_KEY.
BACKEND_SERVICE_API_KEY=your-secret-chatbot-key-here

# ── Ollama (LLM + embeddings) ─────────────────────────────────────────────────
OLLAMA_BASE_URL=http://localhost:11434
LLM_MODEL=toti-qwen-1.7b-v4
EMBEDDING_MODEL=qwen3-embedding:0.6b
LLM_TEMPERATURE=0.7
LLM_TOP_P=0.8
LLM_NUM_CTX=32768

# ── RAG / ChromaDB ────────────────────────────────────────────────────────────
CHROMA_PERSIST_DIR=./chroma_db
CHROMA_COLLECTION=toti_faq
KNOWLEDGE_BASE_DIR=./knowledge_base/faq
RAG_CHUNK_SIZE=512
RAG_CHUNK_OVERLAP=77
RAG_TOP_K=3
# Below this similarity (0..1), the bot refuses to answer (out-of-scope guard).
RAG_SIMILARITY_THRESHOLD=0.40

# ── WhatsApp gateway (wwebjs-api) ─────────────────────────────────────────────
WWEBJS_BASE_URL=http://wwebjs-api:3000
# REQUIRED. Protects the logged-in WhatsApp session (send as the store, read
# chats, export the session). openssl rand -hex 24 — never leave it at a default.
WWEBJS_API_KEY=
WWEBJS_SESSION_ID=toti

# ── Local chatbot DB (SQLite) ─────────────────────────────────────────────────
DATABASE_URL=sqlite+aiosqlite:///./toti_chatbot.db
# Personal-data retention: transcripts older than this are deleted and the
# identity snapshot (nama/alamat/nomor HP) on finished orders is cleared. 0 = off.
DATA_RETENTION_DAYS=90

# ── Payment tracking (charge itself lives in the backend -> Midtrans) ─────────
PAYMENT_CHECK_INTERVAL_SECONDS=30
PAYMENT_TIMEOUT_MINUTES=30
ALLOW_DOWN_PAYMENT=true
DOWN_PAYMENT_PERCENTAGE=0.50

# ── Checkout / identity ───────────────────────────────────────────────────────
AUTOFILL_PHONE_FROM_WA=true

# ── Admin / human takeover ────────────────────────────────────────────────────
ADMIN_WA_NUMBER=628123456789
TAKEOVER_EXPIRY_DAYS=7

# ── Store info (for pickup/delivery messages) ─────────────────────────────────
STORE_NAME=Toti Cakery
STORE_ADDRESS=Jl. Contoh No. 123, Jakarta

# ── Owner gating (financial_report / business_analytics) ──────────────────────
# Comma-separated WA numbers allowed to query owner-only tools.
OWNER_WA_NUMBERS=628123456789
